# Operating System
.DS_Store
._*

# Python environment & bytecode
.venv/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging & distributions
build/
/dist/
*.egg-info/
.eggs/

# Environment variables & secrets
.env
.env.*
!.env.example

# Testing & Linting caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE & Editor artifacts
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Logs
*.log

# Documentation & Reports
!docs/reports/
!docs/reports/**

# Generated teaching data and local runs stay untracked. Versioned protocol
# declarations, reviewed benchmark releases, and the immutable V2 archive are
# explicit exceptions.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/**/*.md
!/data/*.md
!/data/teaching/generation_spec.json
!/data/benchmarks/protocols/**
!/data/benchmarks/published/**
!/data/benchmarks/archive_single_cutoff_28d/**

# Local experiment runs and generated visual assets
/runs/
/images/**
!/images/**/
!/images/**/.gitkeep
!/images/tweedie/**
!/images/benchmarks/**
!/images/grocery-demand.*
!/images/wine-demand.*
!/images/garden-demand.*
!/images/luxury-handbag-demand.*
!/images/retail-demand-profile-adi-cv.*
