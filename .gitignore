# Operating System
.DS_Store
._*

# Python environment & bytecode
.venv/
.python-version
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging & distributions
build/
/dist/
*.egg-info/
.eggs/

# Environment variables & secrets
.env
.env.*
!.env.example

# Testing & Linting caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDE & Editor artifacts
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Logs
*.log

# Documentation & Reports
!docs/reports/
!docs/reports/**

# Data and experiment artifacts are regenerated locally. Keep only directory
# placeholders so CSV, images, manifests, and model output never reach Git.
/data/**
!/data/**/
!/data/**/.gitkeep
!/data/**/*.md
!/data/*.md
!/data/benchmarks/**

# Local experiment runs and generated visual assets
/runs/
/images/**
!/images/**/.gitkeep
